# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MYSQL Database Configuration
# Leave blank to use in-memory state fallback, or provide credentials to connect to a live MySQL instance.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="informatique_system_prosper"
# MYSQL_URL="mysql://root:password@localhost:3306/informatique_system_prosper"
